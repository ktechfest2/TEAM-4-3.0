# --- database ---
DATABASE_URL=postgres://confam:confam@127.0.0.1:54329/confam
# --- Aethex (voice agents) ---
AETHEX_API_KEY=
AETHEX_WEBHOOK_SECRET=          # written by: npm run provision:aethex -w @confam/brain -- --write-env
AETHEX_AGENT_IDS={}             # written by provisioning
# --- Telnyx (carrier) ---
TELNYX_API_KEY=
CONFAM_LINE_NUMBER=+10000000000 # the Confam number, E.164
# --- brain ---
PUBLIC_BRAIN_URL=               # public https URL of apps/brain (ngrok locally, Railway in prod)
CONFAM_TOOL_KEY=                # openssl rand -hex 24
PHONE_PEPPER=                   # openssl rand -base64 32
PHONE_ENC_KEY=                  # openssl rand -base64 32
ELECTION_TZ=Africa/Lagos
DEMO_MODE=true                  # only DEMO_TEAM_PHONES are ever dialled
DEMO_TEAM_PHONES=               # comma-separated E.164 numbers of your team's phones (never commit)
DEMO_OFFICIAL_PIN=              # 4 digits, PIN for the team's polling-official role
# --- dashboard ---
AUTH_SECRET=                    # openssl rand -base64 32
ADMIN_EMAIL=
ADMIN_PASSWORD=                 # used only by: npm run admin:create -w @confam/web
NEXT_TELEMETRY_DISABLED=1
